{
  "compilerOptions": {
    /* Language */
    "target": "ES2022",
    /* Module */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Paths */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    /* Quality */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* Source Maps */
    "sourceMap": true,
    /* Node */
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}