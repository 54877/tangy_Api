// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  userName     String    @map("user_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  gender       String?   @default("male")
  introduction String?
  birthday     DateTime? @db.Date
  role         String    @default("user")
  svType       Boolean   @default(false) @map("sv_type")

  deviceTable deviceTable[]

  @@map("user_table")
}

model svTable {
  id        String   @id @default(uuid())
  email     String   @unique
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  count     Int      @default(0)

  @@map("email_sv")
}

model emailTable {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  count     Int      @default(0)

  @@map("email_verification")
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")

  deviceId String      @map("device_id")
  device   deviceTable @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  revokedAt         DateTime? @map("revoked_at")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")

  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model deviceTable {
  id        String   @id @default(uuid())
  lastUseAt DateTime @default(now()) @map("last_use")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent      String  @map("user_agent")
  deviceType     String? @map("device_type")
  deviceVendor   String? @map("device_vendor")
  deviceModel    String? @map("device_model")
  // OS
  os             String?
  osVersion      String? @map("os_version")
  // Browser
  browser        String?
  browserVersion String? @map("browser_version")

  createdAt DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("device_table")
}
